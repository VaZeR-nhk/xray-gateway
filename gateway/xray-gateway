#!/usr/bin/python3
import os,sys,json,uuid,fcntl,tempfile,subprocess,urllib.request,urllib.error,datetime,time,gzip,base64
from urllib.parse import urlsplit,urlunsplit
from pathlib import Path
BASE=Path("/var/lib/xray-gateway"); ENV_FILE=Path("/etc/xray-gateway/.env")
SUB=BASE/"subscription.json"; CONFIG=BASE/"config.json"
STATE=BASE/"state.json"; LAST=BASE/"config.last-good.json"; LOCK=BASE/"gateway.lock"
def log(s): print("[xray-gateway] "+str(s),flush=True)
def atomic(path,data):
    fd,tmp=tempfile.mkstemp(dir=BASE,prefix=path.name+".")
    try:
        with os.fdopen(fd,"wb") as f: f.write(data); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp,0o600); os.replace(tmp,path)
    except: 
        try: os.unlink(tmp)
        except OSError: pass
        raise
def settings():
    import re
    d={}
    envfile=ENV_FILE
    for line in envfile.read_text().splitlines():
        line=line.strip()
        if line and not line.startswith("#") and "=" in line:
            k,v=line.split("=",1); d[k.strip()]=v.strip()
    if not re.fullmatch(r"https://[A-Za-z0-9._~:/?%+=&-]+",d.get("SUBSCRIPTION_URL","")):
        raise ValueError("SUBSCRIPTION_URL содержит неподдерживаемые символы или не является HTTPS URL")
    if not re.fullmatch(r"[A-Za-z0-9._-]+",d.get("WEB_USERNAME","")):
        raise ValueError("Некорректный WEB_USERNAME в .env")
    if not re.fullmatch(r"[A-Za-z0-9._~!@%+=,-]{12,}",d.get("WEB_PASSWORD","")):
        raise ValueError("Некорректный WEB_PASSWORD в .env")
    hp=BASE/"hwid"
    if not hp.exists(): atomic(hp,(str(uuid.uuid4())+"\n").encode())
    d["HWID"]=hp.read_text().strip()
    if not d.get("SUBSCRIPTION_URL","").startswith("https://"): raise ValueError("SUBSCRIPTION_URL должен начинаться с https://")
    return d
def run(args,timeout=60): return subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)
def active(): 
    r=run(["supervisorctl","status","xray"])
    return r.returncode==0 and "RUNNING" in r.stdout
def restart():
    r=run(["supervisorctl","restart","xray"],30)
    if r.returncode: raise RuntimeError(r.stdout)
    time.sleep(2); s=run(["supervisorctl","status","xray"])
    if s.returncode or "RUNNING" not in s.stdout: raise RuntimeError("Xray не перешёл в RUNNING: "+s.stdout)
def subscription_endpoint(value):
    parts=urlsplit(value.strip())
    if parts.scheme!="https" or not parts.netloc: raise ValueError("URL подписки должен быть HTTPS")
    path=parts.path.rstrip("/")
    if not path.endswith("/json"): path += "/json"
    return urlunsplit((parts.scheme,parts.netloc,path,parts.query,parts.fragment))
def check_subscription_headers(headers):
    """Stop before parsing a placeholder response when Remnawave reports an HWID problem."""
    def enabled(name):
        return str(headers.get(name,"")).strip().lower()=="true"

    if enabled("x-hwid-max-devices-reached") or enabled("x-hwid-limit"):
        message="Remnawave: достигнут лимит устройств по HWID."
        announce=str(headers.get("announce","")).strip()
        if announce.lower().startswith("base64:"):
            try:
                announce=base64.b64decode(announce[7:],validate=True).decode("utf-8").strip()
            except Exception:
                announce=""
        # Keep administrator-provided text readable and prevent terminal control sequences.
        announce=" ".join(announce.replace("\\r"," ").replace("\\n"," ").split())
        if announce:
            message+=f" Сообщение Remnawave: {announce[:500]}"
        raise RuntimeError(message+" Удалите ненужное устройство в панели Remnawave и повторите обновление.")

    if enabled("x-hwid-not-supported"):
        raise RuntimeError("Remnawave не получил поддерживаемый HWID (x-hwid-not-supported). Проверьте заголовок x-hwid и настройки HWID Limit.")


def download(cfg):
    import platform
    endpoint=subscription_endpoint(cfg["SUBSCRIPTION_URL"])
    req=urllib.request.Request(endpoint,headers={
        "User-Agent":cfg.get("USER_AGENT","Happ"),
        "x-hwid":cfg["HWID"],
        "x-device-os":"Linux",
        "x-ver-os":platform.freedesktop_os_release().get("VERSION_ID",""),
        "x-device-model":"Xray Gateway",
        "Accept":"application/json",
        "Accept-Encoding":"gzip"
    })
    try:
        with urllib.request.urlopen(req,timeout=60) as r:
            # Remnawave may return HTTP 200 with a placeholder JSON profile on HWID denial.
            # Inspect response headers before reading or parsing the body.
            check_subscription_headers(r.headers)
            raw=r.read()
            content_type=r.headers.get("Content-Type","unknown")
            encoding=r.headers.get("Content-Encoding","").lower()
        if encoding=="gzip": raw=gzip.decompress(raw)
    except urllib.error.HTTPError as e:
        check_subscription_headers(e.headers or {})
        raise RuntimeError(f"Remnawave HTTP {e.code}; проверь URL подписки и доступ к /json") from e
    if not raw.strip(): raise ValueError("Remnawave вернул пустой ответ")
    try:
        profiles=json.loads(raw.decode("utf-8-sig"))
    except Exception as e:
        raise ValueError(f"Ответ Remnawave не является JSON (Content-Type: {content_type}, байт: {len(raw)}). Используется endpoint /json; проверьте URL подписки") from e
    if not isinstance(profiles,list) or not profiles: raise ValueError("Подписка должна быть непустым JSON-массивом профилей")
    for i,p in enumerate(profiles):
        if not isinstance(p,dict) or not all(k in p for k in ("inbounds","outbounds","routing")): raise ValueError(f"Некорректная структура профиля {i}: отсутствуют inbounds/outbounds/routing")
    log(f"Подписка получена: профилей {len(profiles)}; источник: /json")
    return profiles
def set_subscription_url(value):
    import re
    value=value.strip()
    if not re.fullmatch(r"https://[A-Za-z0-9._~:/?%+=&-]+",value):
        raise ValueError("URL должен быть HTTPS и содержать только безопасные символы")
    endpoint=subscription_endpoint(value)
    envfile=ENV_FILE
    old=envfile.read_bytes()
    lines=envfile.read_text().splitlines()
    out=[]; replaced=False
    for line in lines:
        if line.strip().startswith("SUBSCRIPTION_URL="):
            out.append("SUBSCRIPTION_URL="+value); replaced=True
        else: out.append(line)
    if not replaced: out.append("SUBSCRIPTION_URL="+value)
    envfile.write_text("\n".join(out)+"\n"); os.chmod(envfile,0o600)
    try:
        result=update()
        return result
    except Exception:
        envfile.write_bytes(old); os.chmod(envfile,0o600)
        raise
def active_index(cfg):
    if STATE.exists(): return int(json.loads(STATE.read_text()).get("active_profile",cfg.get("ACTIVE_PROFILE",0)))
    return int(cfg.get("ACTIVE_PROFILE",0))
def build(profile,cfg):
    p=json.loads(json.dumps(profile))
    p.setdefault("inbounds",[])[:] = [x for x in p.get("inbounds",[]) if x.get("tag")!="tproxy-in"]
    if cfg.get("ENABLE_TPROXY","false").lower() in ("1","true","yes","on"):
        import re
        raw_port=str(cfg.get("TPROXY_PORT","12345")).strip()
        if not re.fullmatch(r"[0-9]+",raw_port):
            raise ValueError("TPROXY_PORT должен быть целым числом от 1 до 65535")
        port=int(raw_port,10)
        if not 1 <= port <= 65535:
            raise ValueError("TPROXY_PORT должен быть целым числом от 1 до 65535")
        p["inbounds"].append({"tag":"tproxy-in","listen":cfg.get("GATEWAY_IP","0.0.0.0"),"port":port,"protocol":"dokodemo-door","settings":{"network":"tcp,udp","followRedirect":True},"sniffing":{"enabled":True,"destOverride":["http","tls","quic"],"routeOnly":True},"streamSettings":{"sockopt":{"tproxy":"tproxy"}}})
    return (json.dumps(p,ensure_ascii=False,indent=2)+"\n").encode()
def validate(data):
    fd,tmp=tempfile.mkstemp(dir=BASE,prefix="check-",suffix=".json")
    try:
        with os.fdopen(fd,"wb") as f: f.write(data)
        r=run(["/usr/local/bin/xray","run","-test","-config",tmp])
        if r.returncode: raise RuntimeError(r.stdout)
    finally:
        try: os.unlink(tmp)
        except OSError: pass
def save_state(i,n,action):
    atomic(STATE,(json.dumps({"active_profile":i,"profile_count":n,"last_update":datetime.datetime.now(datetime.timezone.utc).isoformat(),"status":"success","action":action},ensure_ascii=False,indent=2)+"\n").encode())
def apply(i,profiles,action):
    cfg=settings()
    if i<0 or i>=len(profiles): raise ValueError(f"Индекс {i} вне диапазона 0..{len(profiles)-1}")
    new=build(profiles[i],cfg); validate(new)
    old=CONFIG.read_bytes() if CONFIG.exists() else None
    if old==new: save_state(i,len(profiles),"unchanged"); return "Конфигурация уже активна; перезапуск не нужен"
    atomic(CONFIG,new)
    if active():
        try: restart()
        except Exception as e:
            if old is not None:
                atomic(CONFIG,old)
                try: restart()
                except Exception as re: log("КРИТИЧЕСКИЙ ОТКАТ НЕ УДАЛСЯ: "+str(re))
            raise RuntimeError("Не удалось применить профиль: "+str(e))
    atomic(LAST,new); save_state(i,len(profiles),action)
    return f"Профиль {i+1} применён"
def update():
    cfg=settings(); profiles=download(cfg); i=active_index(cfg)
    if i<0 or i>=len(profiles): raise ValueError(f"Активный профиль {i} отсутствует в подписке из {len(profiles)} профилей")
    new=build(profiles[i],cfg); validate(new)
    oldsub=SUB.read_bytes() if SUB.exists() else None
    oldcfg=CONFIG.read_bytes() if CONFIG.exists() else None
    atomic(SUB,(json.dumps(profiles,ensure_ascii=False,separators=(",",":"))+"\n").encode())
    if oldcfg==new:
        save_state(i,len(profiles),"unchanged"); return "Подписка обновлена; активная конфигурация не изменилась"
    atomic(CONFIG,new)
    if active():
        try: restart()
        except Exception as e:
            if oldcfg is not None:
                atomic(CONFIG,oldcfg)
                try: restart()
                except Exception as re: log("КРИТИЧЕСКИЙ ОТКАТ НЕ УДАЛСЯ: "+str(re))
            if oldsub is not None: atomic(SUB,oldsub)
            raise RuntimeError("Обновление откатано: "+str(e))
    atomic(LAST,new); save_state(i,len(profiles),"updated")
    return f"Подписка обновлена, профилей: {len(profiles)}"
def profiles():
    ps=json.loads(SUB.read_text()); cfg=settings(); i=active_index(cfg)
    print(json.dumps({"active_profile":i,"profile_count":len(ps),"profiles":[{"index":n,"name":p.get("remarks") or f"Профиль {n+1}","active":n==i} for n,p in enumerate(ps)]},ensure_ascii=False))
def main():
    cmd=sys.argv[1] if len(sys.argv)>1 else ""
    if cmd=="profiles": profiles(); return
    if cmd not in ("update","select","set-url"): raise ValueError("Использование: xray-gateway profiles | update | select INDEX | set-url HTTPS_URL")
    with LOCK.open("w") as f:
        fcntl.flock(f,fcntl.LOCK_EX)
        if cmd=="update": print(update())
        elif cmd=="set-url":
            if len(sys.argv)!=3: raise ValueError("Укажите новый HTTPS URL подписки")
            print(set_subscription_url(sys.argv[2]))
        else:
            if len(sys.argv)!=3 or not sys.argv[2].isdigit(): raise ValueError("Индекс профиля должен быть целым числом")
            ps=json.loads(SUB.read_text()); print(apply(int(sys.argv[2]),ps,"selected"))
if __name__=="__main__":
    try: main()
    except Exception as e: log("ОШИБКА: "+str(e)); sys.exit(1)
